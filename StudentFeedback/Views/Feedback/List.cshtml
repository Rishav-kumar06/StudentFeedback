@model List<StudentFeedback.Models.Feedback>

@{
    ViewBag.Title = "Feedback List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Feedback List</h2>

<table border="1">

    <tr>
        <th>Name</th>
        <th>Enrollment No</th>
        <th>Subject</th>
        <th>Comment</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.EnrollmentNo</td>
            <td>@item.Subject</td>
            <td>@item.Comment</td>
        </tr>
    }

</table>

<br />

<a href="/Feedback/Create">Create New Feedback</a>

